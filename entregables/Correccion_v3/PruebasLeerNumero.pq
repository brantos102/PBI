let
 Casos = #table({"Caso","Entrada","Esperado","ErrorEsperado","Obligatorio","Entero"}, {
 {"Numero nativo",356179.86,356179.86,false,true,false},
 {"Texto americano","356,179.86",356179.86,false,true,false},
 {"Texto europeo","356.179,86",356179.86,false,true,false},
 {"Dolares","$ 356,179.86",356179.86,false,true,false},
 {"USD europeo","USD 356.179,86",356179.86,false,true,false},
 {"USD sufijo","356179,86 USD",356179.86,false,true,false},
 {"Decimal punto","4950.38",4950.38,false,true,false},
 {"Decimal coma","4950,38",4950.38,false,true,false},
 {"Un decimal","12,5",12.5,false,true,false},
 {"Entero texto","358",358,false,true,true},
 {"Cero","0",0,false,false,false},
 {"Null",null,null,false,false,false},
 {"Vacio","",null,false,false,false},
 {"Espacios","   ",null,false,false,false},
 {"NBSP",Character.FromNumber(160),null,false,false,false},
 {"Espacio estrecho",Character.FromNumber(8239),null,false,false,false},
 {"Guion","-",null,false,false,false},
 {"Guion monetario","$ -",null,false,false,false},
 {"Negativo","-1,234.56",-1234.56,false,true,false},
 {"Negativo monetario","-$ 1,234.56",-1234.56,false,true,false},
 {"Parentesis","($1,234.56)",-1234.56,false,true,false},
 {"Miles multiples","1,234,567",1234567,false,true,false},
 {"Millones europeos","1.234.567,89",1234567.89,false,true,false},
 {"Separador ambiguo","1,234",null,true,false,false},
 {"Separador ambiguo punto","1.234",null,true,false,false},
 {"Texto no numerico","pendiente",null,true,false,false},
 {"Agrupacion incorrecta","12,34.56",null,true,false,false},
 {"Espacio interno invalido","1 2",null,true,false,false},
 {"Moneda interna invalida","1USD2",null,true,false,false},
 {"Doble signo","(-12.00)",null,true,false,false},
 {"Fraccion de factura","1.5",null,true,false,true},
 {"Importe obligatorio vacio","",null,true,true,false},
 {"Importe obligatorio null",null,null,true,true,false},
 {"Booleano",true,null,true,false,false}
 }),
 Evaluacion = Table.AddColumn(Casos,"Resultado",each let
  Intento = try LeerNumero([Entrada],"PRUEBAS","Importe",1,[Obligatorio],[Entero]),
  Correcto = if [ErrorEsperado] then Intento[HasError] else if Intento[HasError] then false else Intento[Value]=[Esperado]
 in [Correcto=Correcto,Valor=if Intento[HasError] then null else Intento[Value],Mensaje=if Intento[HasError] then Intento[Error][Message] else null]),
 Detalle = Table.ExpandRecordColumn(Evaluacion,"Resultado",{"Correcto","Valor","Mensaje"}),
 Fallos = Table.SelectRows(Detalle,each not [Correcto]),
 Verificado = if Table.RowCount(Fallos)>0 then error Error.Record("PruebasFallidas","Hay casos de conversion que no cumplen el resultado esperado",Fallos) else Detalle
in Verificado
