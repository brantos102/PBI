let
 Origen = LeerHoja("BASE KPIS", {"Fecha", "Pais", "Etiquetas de fila", "Suma de importe", "TIPO SERVICIO", "FACTURAS", "Quito", "Guayaquil", "F PAGO", "Ciudad"}, ""),
 // Solo se excluyen filas vacias y subtotales sin fecha Y sin descripcion.
 TieneDato = (v as any) as logical => if v=null then false else if Value.Is(v,type text) then Text.Trim(Text.Replace(Text.Replace(v,Character.FromNumber(160)," "),Character.FromNumber(8239)," "))<>"" else true,
 Detalle = Table.SelectRows(Origen, each TieneDato([Fecha]) or TieneDato([Etiquetas de fila])),
 Nombres = Table.RenameColumns(Detalle, {{"Etiquetas de fila", "Descripcion"}, {"Suma de importe", "Importe"}, {"TIPO SERVICIO", "Tipo"}, {"FACTURAS", "Facturas"}, {"F PAGO", "FormaPago"}, {"Ciudad", "CiudadOrigen"}}),
 NumerosValidados = Table.FromRecords(List.Transform(Table.ToRecords(Nombres), (r) => Record.TransformFields(r, {{"Importe", (v) => LeerNumero(v, "BASE KPIS", "Importe", r[FilaOrigen], true, false)}, {"Facturas", (v) => LeerNumero(v, "BASE KPIS", "Facturas", r[FilaOrigen], false, true)}, {"Quito", (v) => LeerNumero(v, "BASE KPIS", "Quito", r[FilaOrigen], false, false)}, {"Guayaquil", (v) => LeerNumero(v, "BASE KPIS", "Guayaquil", r[FilaOrigen], false, false)}})), Table.ColumnNames(Nombres), MissingField.Error),
 FechasValidadas = Table.TransformColumns(NumerosValidados, {{"Fecha", each if _=null then null else if Value.Is(_, type text) then Date.FromText(_, [Culture="es-EC"]) else Date.From(_), type date}}),
 Tipos = Table.TransformColumnTypes(FechasValidadas, {{"FilaOrigen", Int64.Type}, {"Fecha", type date}, {"Pais", type text}, {"Descripcion", type text}, {"Importe", Currency.Type}, {"Tipo", type text}, {"Facturas", Int64.Type}, {"Quito", Currency.Type}, {"Guayaquil", Currency.Type}, {"FormaPago", type text}, {"CiudadOrigen", type text}}, "en-US"),
 Limpios = Table.TransformColumns(Tipos, {{"Tipo", each Text.Trim(_), type text}, {"FormaPago", each Text.Upper(Text.Trim(_)), type text}}),
 ControlCiudad = Table.AddColumn(Limpios, "DiferenciaCiudad", each [Importe] - (if [Quito]=null then 0 else [Quito]) - (if [Guayaquil]=null then 0 else [Guayaquil]), Currency.Type),
 Claves = List.RemoveItems(Table.ColumnNames(Limpios), {"FilaOrigen"}),
 Grupos = Table.Group(Limpios, Claves, {{"Repeticiones", each Table.RowCount(_), Int64.Type}}),
 Union = Table.NestedJoin(ControlCiudad, Claves, Grupos, Claves, "Grupo", JoinKind.LeftOuter),
 Expandido = Table.ExpandTableColumn(Union, "Grupo", {"Repeticiones"}),
 Alertas = Table.AddColumn(Expandido, "Control", each Text.Combine(List.RemoveNulls({if [Facturas]=null then "FACTURAS vacio" else null, if [Repeticiones]>1 then "Posible duplicado" else null, if Number.Abs([DiferenciaCiudad])>0.005 then "Descuadre ciudad" else null, if [Fecha]=null then "Fecha ausente" else null, if not List.Contains({"Total Compras", "Total Servicios"},[Tipo]) then "Tipo no reconocido" else null}), "; "), type text)
in Alertas