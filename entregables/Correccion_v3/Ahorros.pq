let
 Origen = LeerHoja("AHORROS", {"FECHA", "CATEGORIA", "COTI 1", "COTI 2", "DIFERENCIA"}, ""),
 TieneDato = (v as any) as logical => if v=null then false else if Value.Is(v,type text) then Text.Trim(Text.Replace(Text.Replace(v,Character.FromNumber(160)," "),Character.FromNumber(8239)," "))<>"" else true,
 Detalle = Table.SelectRows(Origen, each TieneDato([FECHA]) or TieneDato([CATEGORIA])),
 Nombres = Table.RenameColumns(Detalle, {{"FECHA", "Fecha"}, {"CATEGORIA", "Categoria"}, {"COTI 1", "Coti1"}, {"COTI 2", "Coti2"}, {"DIFERENCIA", "DiferenciaOriginal"}}),
 NumerosValidados = Table.FromRecords(List.Transform(Table.ToRecords(Nombres), (r) => Record.TransformFields(r, {{"Coti1", (v) => LeerNumero(v, "AHORROS", "Coti1", r[FilaOrigen], true, false)}, {"Coti2", (v) => LeerNumero(v, "AHORROS", "Coti2", r[FilaOrigen], true, false)}})), Table.ColumnNames(Nombres), MissingField.Error),
 FechasValidadas = Table.TransformColumns(NumerosValidados, {{"Fecha", each if _=null then null else if Value.Is(_, type text) then Date.FromText(_, [Culture="es-EC"]) else Date.From(_), type date}}),
 Tipos = Table.TransformColumnTypes(FechasValidadas, {{"FilaOrigen", Int64.Type}, {"Fecha", type date}, {"Categoria", type text}, {"Coti1", Currency.Type}, {"Coti2", Currency.Type}, {"DiferenciaOriginal", type text}}, "en-US"),
 Categorias = Table.TransformColumns(Tipos, {{"Categoria", each if _=null then "Sin categoria (sin gestion)" else Text.Trim(_), type text}}),
 Calculado = Table.AddColumn(Categorias, "Ahorro", each [Coti1]-[Coti2], Currency.Type),
 Declarado = Table.AddColumn(Calculado, "AhorroDeclarado", each let n=LeerNumero([DiferenciaOriginal], "AHORROS", "DIFERENCIA", [FilaOrigen], false, false) in if n<>null then n else if [Coti1]=0 and [Coti2]=0 then 0 else error Error.Record("AhorroSinDeclarar", "Falta DIFERENCIA en AHORROS", [FilaOrigen=[FilaOrigen], ValorOriginal=[DiferenciaOriginal]]), Currency.Type),
 Control = Table.AddColumn(Declarado, "DiferenciaControl", each [Ahorro]-[AhorroDeclarado], Currency.Type)
in Control